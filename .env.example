# Supabase Configuration (running on VM host)
DATABASE_URL=postgresql://postgres:your-password@host.docker.internal:5432/postgres
SUPABASE_URL=http://host.docker.internal:8000
SUPABASE_KEY=your-supabase-anon-key

# External API Keys
# Twilio Verify (SMS/WhatsApp OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MapTiler (Maps & Geocoding)
MAPTILER_API_KEY=your-maptiler-api-key

# WeatherAPI (Weather forecasts)
WEATHER_API_KEY=your-weather-api-key

# Application Settings (optional)
# DEBUG=false
# LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database URL (optional, if using direct PostgreSQL connection)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/postgres

# Application Settings
DEBUG=true
LOG_LEVEL=info

# Web Push (VAPID) — Anforderung K4 Erinnerungen
# Einmalig generieren mit:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print('priv:', v.private_pem().decode()); print('pub:', v.public_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@happin.fun
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_SECONDS=60
